{
  "manifest_version": 3,
  "name": "AI Execute Runner",
  "version": "2.5.1.1",
  "description": "Выполнение команд из execute-блоков ChatGPT / Claude / Arena на локальном ПК. Нейросеть пишет ```execute — вы подтверждаете — команда выполняется локально — вывод возвращается в чат.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://arena.ai/*",
        "*://*.arena.ai/*",
        "*://lmarena.ai/*",
        "*://*.lmarena.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://aistudio.google.com/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://perplexity.ai/*",
        "*://*.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://chat.qwen.ai/*",
        "*://chat.mistral.ai/*",
        "*://google.com/*",
        "*://www.google.com/*",
        "*://google.ru/*",
        "*://www.google.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Execute Runner"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-execute-runner@arena.local",
      "strict_min_version": "109.0"
    }
  }
}
